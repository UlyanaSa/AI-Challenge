# Настройки приватного AI-сервиса (день 30).
#
# Скопируйте файл и заполните: `cp .env.example .env`.
# Сам `.env` в репозиторий не попадает (см. .gitignore) — ключи и секреты
# в исходном коде не хранятся, и в образ он не копируется (см. .dockerignore).

# Ключ доступа к API сервиса. Обязателен: без него `/api/*` отвечает 503, а
# `docker compose up` останавливается с этой же причиной.
# Сгенерировать: `openssl rand -hex 32`
SERVICE_API_KEY=впишите-ключ

# Дополнительные ключи (несколько клиентов), через запятую. Необязательно.
# SERVICE_API_KEYS=

# Порт сервиса: и публикация на хосте, и прослушивание в контейнере.
SERVICE_PORT=8080

# Ограничения из задания. Значения ниже — начальные, а не единственно верные:
# параллельность ограничена возможностями машины, на которой работает модель.
SERVICE_RATE_LIMIT_PER_MINUTE=10
SERVICE_MAX_CONCURRENT_GENERATIONS=2
SERVICE_QUEUE_LIMIT=4
SERVICE_QUEUE_WAIT_MS=15000
SERVICE_MAX_CONTEXT_TOKENS=4096
SERVICE_MAX_GENERATION_TOKENS=512

# Обязательная системная инструкция сервиса: уходит модели первым сообщением и
# не выбрасывается усечением контекста. Пусто — умолчание из кода.
# SERVICE_SYSTEM_PROMPT=

# Сводка прошлого чата: при создании нового чата сервис сворачивает последние
# сообщения самого свежего другого чата и добавляет её в системную инструкцию.
# `false` — не строить сводку никогда (в теле запроса это же делает "summarize": false).
SERVICE_SUMMARY_ENABLED=true
# Инструкция сводки. Пусто — умолчание из кода (факты, числа, имена; без вступлений).
# SERVICE_SUMMARY_PROMPT=
SERVICE_SUMMARY_MAX_TOKENS=256
SERVICE_SUMMARY_MAX_MESSAGES=40

# Потолок `limit` в списке чатов (`GET /api/chats`): больше него клиент не получит.
SERVICE_CHATS_LIST_LIMIT=100

# Провайдер и модель. В контейнере Ollama — на хосте, а не рядом с сервисом.
LLM_PROVIDER=local
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_THINK=true
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_MS=120000

# Память JVM контейнера.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75

# Ключ облачного провайдера нужен только при LLM_PROVIDER=deepseek.
# DEEPSEEK_API_KEY=
