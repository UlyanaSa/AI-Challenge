# Что не уезжает в контекст сборки образа.
#
# `.env` — первым делом: ключи и секреты не должны попадать ни в образ, ни в его слои,
# откуда их достают даже после удаления файла в следующем слое.
.env

# История работы и артефакты сборки: в образе они не нужны, а контекст раздувают.
.git
.gradle
.kotlin
.idea
**/build/
build/
*.iml
local.properties
node_modules/
kotlin-js-store/
captures/

# Данные сервиса: в контейнер они приходят томом, а не копией с хоста.
server/data/
*.db
*.db-shm
*.db-wal

# Отчёты и заметки: сервису они не нужны.
.DS_Store
docs/
